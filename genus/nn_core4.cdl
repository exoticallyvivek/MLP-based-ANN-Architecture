module DFFQX1(CK, D, Q);
  input CK, D;
  output Q;
  wire CK, D;
  wire Q;
  wire next_state;
  reg  qi;
  assign #1 Q = qi;
  assign next_state = D;
  always 
    @(posedge CK) 
      qi <= next_state;
  initial 
    qi <= 1'b0;
endmodule

module SDFFQX1(CK, D, SE, SI, Q);
  input CK, D, SE, SI;
  output Q;
  wire CK, D, SE, SI;
  wire Q;
  wire next_state, w1033, w1034, w1035;
  reg  qi;
  assign #1 Q = qi;
  not g1157 (w1033, SE);
  nand g1158 (w1034, w1033, D);
  nand g1159 (w1035, SI, SE);
  nand g1160 (next_state, w1034, w1035);
  always 
    @(posedge CK) 
      qi <= next_state;
  initial 
    qi <= 1'b0;
endmodule
