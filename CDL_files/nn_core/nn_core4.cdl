*******************************************************************************
* nn_core4.cdl — Top-level: forward4 + backward4 + gen_din_sel4 + delays
* Ref libs: gpdk090 + stdcel + your working lib (has forward4, backward4)
*******************************************************************************

*=== STD CELL STUBS ===*
.SUBCKT INVX1 A Y VDD VSS
.ENDS INVX1

.SUBCKT DFFQX1 CK D Q VDD VSS
.ENDS DFFQX1

.SUBCKT NOR2X1 A B Y VDD VSS
.ENDS NOR2X1

.SUBCKT NAND2X1 A B Y VDD VSS
.ENDS NAND2X1

.SUBCKT XNOR2X1 A B Y VDD VSS
.ENDS XNOR2X1

*=== DERIVED WRAPPERS ===*
.SUBCKT AND2X1 A B Y VDD VSS
XNAND1 A B n_ab VDD VSS / NAND2X1
XINV1 n_ab Y VDD VSS / INVX1
.ENDS AND2X1

.SUBCKT OR2X1 A B Y VDD VSS
XNOR1 A B n_ab VDD VSS / NOR2X1
XINV1 n_ab Y VDD VSS / INVX1
.ENDS OR2X1

.SUBCKT XOR2X1 A B Y VDD VSS
XXNOR1 A B n_ab VDD VSS / XNOR2X1
XINV1 n_ab Y VDD VSS / INVX1
.ENDS XOR2X1

.SUBCKT MX2X1 A B S0 Y VDD VSS
XINV_S0 S0 S0b VDD VSS / INVX1
XNA A S0b na VDD VSS / NAND2X1
XNB B S0 nb VDD VSS / NAND2X1
XOUT na nb Y VDD VSS / NAND2X1
.ENDS MX2X1

.SUBCKT CLKINVX1 A Y VDD VSS
XINV1 A Y VDD VSS / INVX1
.ENDS CLKINVX1

.SUBCKT CLKXOR2X1 A B Y VDD VSS
XXOR1 A B Y VDD VSS / XOR2X1
.ENDS CLKXOR2X1

.SUBCKT SDFFQX1 CK D SI SE Q VDD VSS
XMUX1 D SI SE net_mux VDD VSS / MX2X1
XDFF1 CK net_mux Q VDD VSS / DFFQX1
.ENDS SDFFQX1

*=== BLOCK STUBS (real schematics in working lib) ===*
.SUBCKT forward4
+ clk reset din select_initial update_coeff
+ input_k1_0 input_k1_1 input_k1_2 input_k1_3
+ input_k2_0 input_k2_1 input_k2_2 input_k2_3
+ cap_dw2_11_0 cap_dw2_11_1 cap_dw2_11_2 cap_dw2_11_3
+ cap_dw2_21_0 cap_dw2_21_1 cap_dw2_21_2 cap_dw2_21_3
+ cap_dw2_12_0 cap_dw2_12_1 cap_dw2_12_2 cap_dw2_12_3
+ cap_dw2_22_0 cap_dw2_22_1 cap_dw2_22_2 cap_dw2_22_3
+ cap_dw3_11_0 cap_dw3_11_1 cap_dw3_11_2 cap_dw3_11_3
+ cap_dw3_21_0 cap_dw3_21_1 cap_dw3_21_2 cap_dw3_21_3
+ cap_db2_1_0 cap_db2_1_1 cap_db2_1_2 cap_db2_1_3
+ cap_db2_2_0 cap_db2_2_1 cap_db2_2_2 cap_db2_2_3
+ cap_db3_1_0 cap_db3_1_1 cap_db3_1_2 cap_db3_1_3
+ w3_11_0 w3_11_1 w3_11_2 w3_11_3
+ w3_21_0 w3_21_1 w3_21_2 w3_21_3
+ a2_1_0 a2_1_1 a2_1_2 a2_1_3
+ a2_2_0 a2_2_1 a2_2_2 a2_2_3
+ a3_1_0 a3_1_1 a3_1_2 a3_1_3
+ k1_out_0 k1_out_1 k1_out_2 k1_out_3
+ k2_out_0 k2_out_1 k2_out_2 k2_out_3
+ t1_out_0 t1_out_1 t1_out_2 t1_out_3
+ finish_updating VDD VSS
.ENDS forward4

.SUBCKT backward4 clk res
+ a3_1_0 a3_1_1 a3_1_2 a3_1_3
+ a2_1_0 a2_1_1 a2_1_2 a2_1_3
+ a2_2_0 a2_2_1 a2_2_2 a2_2_3
+ k1_0 k1_1 k1_2 k1_3
+ k2_0 k2_1 k2_2 k2_3
+ t1_0 t1_1 t1_2 t1_3
+ w3_11_0 w3_11_1 w3_11_2 w3_11_3
+ w3_21_0 w3_21_1 w3_21_2 w3_21_3
+ cap_dw3_11_0 cap_dw3_11_1 cap_dw3_11_2 cap_dw3_11_3
+ cap_dw3_21_0 cap_dw3_21_1 cap_dw3_21_2 cap_dw3_21_3
+ cap_dw2_11_0 cap_dw2_11_1 cap_dw2_11_2 cap_dw2_11_3
+ cap_dw2_21_0 cap_dw2_21_1 cap_dw2_21_2 cap_dw2_21_3
+ cap_dw2_12_0 cap_dw2_12_1 cap_dw2_12_2 cap_dw2_12_3
+ cap_dw2_22_0 cap_dw2_22_1 cap_dw2_22_2 cap_dw2_22_3
+ cap_db3_1_0 cap_db3_1_1 cap_db3_1_2 cap_db3_1_3
+ cap_db2_1_0 cap_db2_1_1 cap_db2_1_2 cap_db2_1_3
+ cap_db2_2_0 cap_db2_2_1 cap_db2_2_2 cap_db2_2_3
+ VDD VSS
.ENDS backward4

