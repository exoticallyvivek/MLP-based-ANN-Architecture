*******************************************************************************
* MODULE: gen_din_sel4
*******************************************************************************
.SUBCKT gen_din_sel4 clk res din select_initial VDD VSS
Xsel_i_reg_reg clk res select_initial VDD VSS / DFFQX1
.ENDS gen_din_sel4

*******************************************************************************
* MODULE: nn_core4 (TOP)
*******************************************************************************
.SUBCKT nn_core4 clk res update_coeff
+ input_k1_0 input_k1_1 input_k1_2 input_k1_3
+ input_k2_0 input_k2_1 input_k2_2 input_k2_3
+ finish_updating
+ a3_1_0 a3_1_1 a3_1_2 a3_1_3
+ VDD VSS

*--- finish_updating tied VSS (assign finish_updating=1b0) ---*


*--- Reset buffer chain ---*
Xg3 res n_0 VDD VSS / CLKINVX1
Xg1 n_0 n_4 VDD VSS / CLKINVX1
Xg7 n_0 n_8 VDD VSS / CLKINVX1
Xg8 n_0 n_5 VDD VSS / CLKINVX1
Xg11 n_0 n_11 VDD VSS / CLKINVX1
Xg10 n_0 n_9 VDD VSS / CLKINVX1

*--- gen_din_sel4: generates select_initial ---*
XGDS clk n_5 UNCONNECTED77 select_initial VDD VSS / gen_din_sel4

*--- a2_1 delay chain (2 stages) ---*
XDA2_1 clk n_11 a2_1_0 a2_1_1 a2_1_2 a2_1_3 tmp_a2_1_0 tmp_a2_1_1 tmp_a2_1_2 tmp_a2_1_3 VDD VSS / delay1_4_375
XDA2_3 clk res tmp_a2_1_0 tmp_a2_1_1 tmp_a2_1_2 tmp_a2_1_3 tmp2_a2_1_0 tmp2_a2_1_1 tmp2_a2_1_2 tmp2_a2_1_3 VDD VSS / delay1_4_373

*--- a2_2 delay chain (2 stages) ---*
XDA2_2 clk n_5 a2_2_0 a2_2_1 a2_2_2 a2_2_3 tmp_a2_2_0 tmp_a2_2_1 tmp_a2_2_2 tmp_a2_2_3 VDD VSS / delay1_4_374
XDA2_4 clk n_8 tmp_a2_2_0 tmp_a2_2_1 tmp_a2_2_2 tmp_a2_2_3 tmp2_a2_2_0 tmp2_a2_2_1 tmp2_a2_2_2 tmp2_a2_2_3 VDD VSS / delay1_4_372

*--- k1 delay chain (4 stages) ---*
XDK1_1 clk n_11 k1_0 k1_1 k1_2 k1_3 tmp_k1_0 tmp_k1_1 tmp_k1_2 tmp_k1_3 VDD VSS / delay1_4_371
XDK1_2 clk n_9 tmp_k1_0 tmp_k1_1 tmp_k1_2 tmp_k1_3 tmp2_k1_0 tmp2_k1_1 tmp2_k1_2 tmp2_k1_3 VDD VSS / delay1_4_370
XDK1_3 clk res tmp2_k1_0 tmp2_k1_1 tmp2_k1_2 tmp2_k1_3 tmp3_k1_0 tmp3_k1_1 tmp3_k1_2 tmp3_k1_3 VDD VSS / delay1_4_369
XDK1_4 clk res tmp3_k1_0 tmp3_k1_1 tmp3_k1_2 tmp3_k1_3 tmp4_k1_0 tmp4_k1_1 tmp4_k1_2 tmp4_k1_3 VDD VSS / delay1_4_368

*--- k2 delay chain (4 stages) ---*
XDK2_1 clk n_9 k2_0 k2_1 k2_2 k2_3 tmp_k2_0 tmp_k2_1 tmp_k2_2 tmp_k2_3 VDD VSS / delay1_4_367
XDK2_2 clk n_8 tmp_k2_0 tmp_k2_1 tmp_k2_2 tmp_k2_3 tmp2_k2_0 tmp2_k2_1 tmp2_k2_2 tmp2_k2_3 VDD VSS / delay1_4_366
XDK2_3 clk res tmp2_k2_0 tmp2_k2_1 tmp2_k2_2 tmp2_k2_3 tmp3_k2_0 tmp3_k2_1 tmp3_k2_2 tmp3_k2_3 VDD VSS / delay1_4_365
XDK2_4 clk n_5 tmp3_k2_0 tmp3_k2_1 tmp3_k2_2 tmp3_k2_3 tmp4_k2_0 tmp4_k2_1 tmp4_k2_2 tmp4_k2_3 VDD VSS / delay1_4_364

*--- t1 delay chain (4 stages, only bit[2] used) ---*
* DT1_1: in={UNC_Z60,UNC_Z59,UNC_Z58,t1[2]} out={UNC63,tmp_t1[2],UNC62,UNC61}
XDT1_1 clk n_5 t1_2 UNCONNECTED_HIER_Z58 UNCONNECTED_HIER_Z59 UNCONNECTED_HIER_Z60 UNCONNECTED61 UNCONNECTED62 tmp_t1_2 UNCONNECTED63 VDD VSS / delay1_4_36
* DT1_2: in={UNC_Z63,UNC_Z62,UNC_Z61,tmp_t1[2]} out={UNC66,tmp2_t1[2],UNC65,UNC64}
