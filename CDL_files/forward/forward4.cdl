*******************************************************************************
* forward4.cdl — All sub-modules + forward4 top
* Syntax: mem4_slim.cdl working reference (/ CELLNAME style)
* Ref libs needed on import: gpdk090, your stdcel lib (has mem4)
*******************************************************************************
*******************************************************************************
* STD CELL STUBS — real transistor layouts exist in your stdcel lib
*******************************************************************************
.SUBCKT INVX1 A Y VDD VSS
*.PININFO A:I Y:O VDD:I VSS:I
.ENDS INVX1

.SUBCKT NAND2X1 A B Y VDD VSS
*.PININFO A:I B:I Y:O VDD:I VSS:I
.ENDS NAND2X1

.SUBCKT NOR2X1 A B Y VDD VSS
*.PININFO A:I B:I Y:O VDD:I VSS:I
.ENDS NOR2X1

.SUBCKT XNOR2X1 A B Y VDD VSS
*.PININFO A:I B:I Y:O VDD:I VSS:I
.ENDS XNOR2X1

.SUBCKT DFFQX1 CK D Q VDD VSS
*.PININFO CK:I D:I Q:O VDD:I VSS:I
.ENDS DFFQX1

*******************************************************************************
* DERIVED CELL WRAPPERS — built from stubs above
*******************************************************************************

* AND2X1 = NAND2 + INV
.SUBCKT AND2X1 A B Y VDD VSS
XNAND1 A B n_ab VDD VSS / NAND2X1
XINV1 n_ab Y VDD VSS / INVX1
.ENDS AND2X1

* OR2X1 = NOR2 + INV
.SUBCKT OR2X1 A B Y VDD VSS
XNOR1 A B n_ab VDD VSS / NOR2X1
XINV1 n_ab Y VDD VSS / INVX1
.ENDS OR2X1

* XOR2X1 = XNOR2 + INV
.SUBCKT XOR2X1 A B Y VDD VSS
XXNOR1 A B n_ab VDD VSS / XNOR2X1
XINV1 n_ab Y VDD VSS / INVX1
.ENDS XOR2X1

* MX2X1: Y=A when S0=0, Y=B when S0=1
* Standard NAND-NAND-NAND-INV mux
* Y = NAND( NAND(A,~S0), NAND(B,S0) )
.SUBCKT MX2X1 A B S0 Y VDD VSS
XINV_S0 S0 S0b VDD VSS / INVX1
XNA A S0b na VDD VSS / NAND2X1
XNB B S0 nb VDD VSS / NAND2X1
XOUT na nb Y VDD VSS / NAND2X1
.ENDS MX2X1

*******************************************************************************
* MAPPING WRAPPERS — clock variants + scan DFF
*******************************************************************************

* CLKINVX1 = INVX1
.SUBCKT CLKINVX1 A Y VDD VSS
XINV1 A Y VDD VSS / INVX1
.ENDS CLKINVX1

* CLKXOR2X1 = XOR2X1 (which = XNOR2X1 + INVX1)
.SUBCKT CLKXOR2X1 A B Y VDD VSS
XXOR1 A B Y VDD VSS / XOR2X1
.ENDS CLKXOR2X1

* SDFFQX1: SE=0→Q=D, SE=1→Q=SI
.SUBCKT SDFFQX1 CK D SI SE Q VDD VSS
XMUX1 D SI SE net_mux VDD VSS / MX2X1
XDFF1 CK net_mux Q VDD VSS / DFFQX1
.ENDS SDFFQX1

*******************************************************************************
* mem4 STUB (real schematic in stdcel lib)
*******************************************************************************
.SUBCKT mem4 CLK DIN ADDR3 ADDR2 ADDR1 ADDR0 DOUT3 DOUT2 DOUT1 DOUT0 VDD VSS
*.PININFO CLK:I DIN:I ADDR3:I ADDR2:I ADDR1:I ADDR0:I
*.PININFO DOUT3:O DOUT2:O DOUT1:O DOUT0:O VDD:I VSS:I
.ENDS mem4


*******************************************************************************
* MODULE: k1_rom4
* Ports: clk din addr[3:0] k_out[3:0]
* Only k_out[2:1] driven (others float)
*******************************************************************************
.SUBCKT k1_rom4 clk din addr_0 addr_1 addr_2 addr_3 k_out_0 k_out_1 k_out_2 k_out_3 VDD VSS
*.PININFO clk:I din:I addr_0:I addr_1:I addr_2:I addr_3:I
*.PININFO k_out_0:O k_out_1:O k_out_2:O k_out_3:O VDD:I VSS:I

Xk_out_reg_1 clk n_3 k_out_1 VDD VSS / DFFQX1
Xk_out_reg_2 clk n_1 k_out_2 VDD VSS / DFFQX1
Xg37 n_2 addr_1 n_3 VDD VSS / NOR2X1
Xg38 n_1 n_2 VDD VSS / CLKINVX1
Xg39 addr_2 addr_3 n_1 VDD VSS / NOR2X1

.ENDS k1_rom4

*******************************************************************************
* MODULE: k2_rom4
*******************************************************************************
.SUBCKT k2_rom4 clk din addr_0 addr_1 addr_2 addr_3 k_out_0 k_out_1 k_out_2 k_out_3 VDD VSS
*.PININFO clk:I din:I addr_0:I addr_1:I addr_2:I addr_3:I
*.PININFO k_out_0:O k_out_1:O k_out_2:O k_out_3:O VDD:I VSS:I

Xk_out_reg_1 clk n_3 k_out_1 VDD VSS / DFFQX1
Xk_out_reg_2 clk n_1 k_out_2 VDD VSS / DFFQX1
Xg37 n_2 addr_0 n_3 VDD VSS / NOR2X1
Xg38 n_1 n_2 VDD VSS / CLKINVX1
Xg39 addr_2 addr_3 n_1 VDD VSS / NOR2X1

.ENDS k2_rom4

*******************************************************************************
* MODULE: t1_rom4
* Note: register index [0] outputs to t_out[2] (Genus remap)
*******************************************************************************
.SUBCKT t1_rom4 clk din addr_0 addr_1 addr_2 addr_3 t_out_0 t_out_1 t_out_2 t_out_3 VDD VSS
*.PININFO clk:I din:I addr_0:I addr_1:I addr_2:I addr_3:I
*.PININFO t_out_0:O t_out_1:O t_out_2:O t_out_3:O VDD:I VSS:I

Xt_out_reg_0 clk n_3 t_out_2 VDD VSS / DFFQX1
Xg30 n_1 n_2 n_3 VDD VSS / AND2X1
Xg31 addr_2 addr_1 n_2 VDD VSS / NOR2X1
Xg32 addr_3 addr_0 n_1 VDD VSS / NOR2X1

.ENDS t1_rom4

*******************************************************************************
* MODULE: counter4
* finish_updating port has no driver (Genus removed Nupdate counter)
*******************************************************************************
.SUBCKT counter4 clk reset out_0 out_1 out_2 out_3 finish_updating VDD VSS
*.PININFO clk:I reset:I out_0:O out_1:O out_2:O out_3:O finish_updating:O VDD:I VSS:I

Xout_reg_0 clk n_15 out_0 VDD VSS / DFFQX1
Xout_reg_1 clk n_12 out_1 VDD VSS / DFFQX1
Xout_reg_2 clk n_14 out_2 VDD VSS / DFFQX1
Xout_reg_3 clk n_13 out_3 VDD VSS / DFFQX1
Xg226 out_0 n_11 n_15 VDD VSS / NOR2X1
Xg227 n_7 n_10 n_14 VDD VSS / AND2X1
Xg228 n_9 n_11 n_13 VDD VSS / NOR2X1
Xg229 n_0 n_11 n_12 VDD VSS / NOR2X1
Xg230 n_10 n_11 VDD VSS / CLKINVX1
Xg231 n_8 reset n_10 VDD VSS / NOR2X1
Xg232 out_3 n_5 n_9 VDD VSS / CLKXOR2X1
Xg233 n_19 out_0 n_8 VDD VSS / NOR2X1
Xg234 out_2 n_3 n_7 VDD VSS / XNOR2X1
Xg237 n_2 n_3 n_5 VDD VSS / OR2X1
Xg239 out_1 out_0 n_3 VDD VSS / NAND2X1
Xg241 out_2 n_2 VDD VSS / CLKINVX1
Xg2 out_0 out_1 n_0 VDD VSS / XNOR2X1
Xg244 n_18 out_1 n_19 VDD VSS / OR2X1
Xg3 out_3 out_2 n_18 VDD VSS / NAND2X1

.ENDS counter4

*******************************************************************************
* MODULE: selector4
*******************************************************************************
.SUBCKT selector4 clk reset update_coeff enable_update VDD VSS
*.PININFO clk:I reset:I update_coeff:I enable_update:O VDD:I VSS:I

Xenable_update_reg clk n_16 enable_update VDD VSS / DFFQX1
Xg177 n_15 reset n_16 VDD VSS / NOR2X1
Xg178 n_14 update_coeff n_15 VDD VSS / NAND2X1
Xg180 n_12 n_13 n_14 VDD VSS / NOR2X1
Xg181 cnt_3 cnt_2 n_13 VDD VSS / NAND2X1
Xg182 cnt_1 cnt_0 n_12 VDD VSS / OR2X1
Xcnt_reg_0 clk n_5 cnt_0 VDD VSS / DFFQX1
Xcnt_reg_1 clk n_8 cnt_1 VDD VSS / DFFQX1
Xcnt_reg_2 clk n_10 cnt_2 VDD VSS / DFFQX1
Xcnt_reg_3 clk n_11 cnt_3 VDD VSS / DFFQX1
Xg224 n_9 n_21 n_11 VDD VSS / NOR2X1
Xg226 n_7 n_21 n_10 VDD VSS / NOR2X1
Xg227 cnt_3 n_6 n_9 VDD VSS / CLKXOR2X1
Xg229 n_4 n_21 n_8 VDD VSS / NOR2X1
Xg230 cnt_2 n_1 n_7 VDD VSS / CLKXOR2X1
Xg231 n_2 cnt_2 n_6 VDD VSS / NAND2X1
Xg232 cnt_0 n_21 n_5 VDD VSS / NOR2X1
Xg233 cnt_0 cnt_1 n_4 VDD VSS / XNOR2X1
Xg235 n_1 n_2 VDD VSS / CLKINVX1
Xg236 cnt_1 cnt_0 n_1 VDD VSS / NAND2X1
Xg2 n_14 reset n_21 VDD VSS / OR2X1

.ENDS selector4

*******************************************************************************
* MODULE: sel_k4
*******************************************************************************
.SUBCKT sel_k4 kin_0 kin_1 kin_2 kin_3 krom_0 krom_1 krom_2 krom_3 upd k_0 k_1 k_2 k_3 VDD VSS

Xg59 kin_2 krom_2 upd k_2 VDD VSS / MX2X1
Xg60 kin_1 krom_1 upd k_1 VDD VSS / MX2X1
Xg61 n_0 kin_3 k_3 VDD VSS / AND2X1
Xg62 n_0 kin_0 k_0 VDD VSS / AND2X1
Xg63 upd n_0 VDD VSS / CLKINVX1

.ENDS sel_k4

*******************************************************************************
* MODULE: sel_k4_86  (identical structure to sel_k4)
*******************************************************************************
.SUBCKT sel_k4_86 kin_0 kin_1 kin_2 kin_3 krom_0 krom_1 krom_2 krom_3 upd k_0 k_1 k_2 k_3 VDD VSS

Xg59 kin_2 krom_2 upd k_2 VDD VSS / MX2X1
Xg60 kin_1 krom_1 upd k_1 VDD VSS / MX2X1
Xg61 n_0 kin_3 k_3 VDD VSS / AND2X1
Xg62 n_0 kin_0 k_0 VDD VSS / AND2X1
Xg63 upd n_0 VDD VSS / CLKINVX1

.ENDS sel_k4_86

